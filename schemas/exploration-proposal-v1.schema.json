{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "exploration-proposal/v1",
      "default": "exploration-proposal/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "source_memory_id": {
      "title": "Source Memory Id",
      "type": "string"
    },
    "source_goal_id": {
      "title": "Source Goal Id",
      "type": "string"
    },
    "goal_id": {
      "title": "Goal Id",
      "type": "string"
    },
    "reason": {
      "enum": [
        "memoryGap",
        "hypothesis",
        "blocker",
        "failureLesson",
        "environment"
      ],
      "title": "Reason",
      "type": "string"
    },
    "intent": {
      "maxLength": 4500,
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "permission_class": {
      "const": "green",
      "default": "green",
      "title": "Permission Class",
      "type": "string"
    },
    "labels": {
      "items": {
        "enum": [
          "research",
          "review"
        ],
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Labels",
      "type": "array"
    },
    "code_write_required": {
      "const": false,
      "default": false,
      "title": "Code Write Required",
      "type": "boolean"
    },
    "state": {
      "const": "reservedForReadOnlyEvaluation",
      "default": "reservedForReadOnlyEvaluation",
      "title": "State",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "source_memory_id",
    "source_goal_id",
    "goal_id",
    "reason",
    "intent",
    "created_at"
  ],
  "title": "ExplorationProposal",
  "type": "object"
}
